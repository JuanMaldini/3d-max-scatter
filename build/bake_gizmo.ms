/*  MaxScatter -- gizmo mesh baker (dev tool, not shipped)

    Regenerates src/MaxScatter/emit/gizmo_data.ms: the world sign, the text
    "MaxScatter" inside a rectangle, baked to plain vert/face arrays.

    Why bake at all: building the sign needs a temporary Text+Extrude node, and
    creating scene nodes is illegal in getDisplayMesh and yields an empty
    snapshot inside the plugin's own creation context. The old code dodged that
    by building on the first regen -- which is why a freshly created helper
    showed a placeholder bar until some parameter changed. Baked data has no
    such ordering problem, needs no font installed, and costs nothing at load.

    steps:0 on the Text keeps the glyph outlines at their control points: 462
    verts instead of 2298, and at icon size in a viewport the difference is
    invisible.

    The output is NORMALIZED -- the rectangle is exactly 1.0 wide and centred
    on the origin -- so it carries no unit-system assumption. The runtime scales
    it by iconSize and nothing else.

    Run: fileIn "build/bake_gizmo.ms" from a Max session, then commit the
    regenerated gizmo_data.ms.
*/

(
    local outPath = (getFilenamePath (getSourceFileName())) + \
        "..\\src\\MaxScatter\\emit\\gizmo_data.ms"

    /*  Arbitrary working width: everything is normalized at the end, so the
        only thing that matters here are the proportions.  */
    local W = 100.0

    local tn = text text:"MaxScatter" size:(W * 0.18) steps:0
    addModifier tn (Extrude amount:(W * 0.002))
    local tm = snapshotAsMesh tn
    delete tn

    local verts = #(), faces = #()

    -- text verts, recentred on the origin
    local mn = [1e9,1e9,1e9], mx = [-1e9,-1e9,-1e9]
    for v = 1 to tm.numVerts do
    (
        local p = getVert tm v
        mn.x = amin mn.x p.x; mn.y = amin mn.y p.y; mn.z = amin mn.z p.z
        mx.x = amax mx.x p.x; mx.y = amax mx.y p.y; mx.z = amax mx.z p.z
    )
    local ctr = (mn + mx) * 0.5
    for v = 1 to tm.numVerts do append verts ((getVert tm v) - ctr)
    for f = 1 to tm.numFaces do append faces (getFace tm f)
    free tm

    fn bakeBox verts faces mn mx =
    (
        local base = verts.count
        append verts [mn.x,mn.y,mn.z]; append verts [mx.x,mn.y,mn.z]
        append verts [mx.x,mx.y,mn.z]; append verts [mn.x,mx.y,mn.z]
        append verts [mn.x,mn.y,mx.z]; append verts [mx.x,mn.y,mx.z]
        append verts [mx.x,mx.y,mx.z]; append verts [mn.x,mx.y,mx.z]
        for f in #([1,3,2],[1,4,3],[5,6,7],[5,7,8],[1,2,6],[1,6,5], \
                   [2,3,7],[2,7,6],[3,4,8],[3,8,7],[4,1,5],[4,5,8]) do
            append faces (f + [base,base,base])
        ok
    )

    -- containing rectangle, padded around the text
    local tw = mx.x - mn.x, th = mx.y - mn.y
    local rw = 0.5 * (amax W (tw * 1.25))
    local rh = 0.5 * (amax (W * 0.3) (th * 2.2))
    local bar = W * 0.02, hz = W * 0.002
    bakeBox verts faces [-rw, rh - bar, -hz] [ rw,       rh,       hz]   -- top
    bakeBox verts faces [-rw, -rh,      -hz] [ rw,      -rh + bar, hz]   -- bottom
    bakeBox verts faces [-rw, -rh,      -hz] [-rw + bar, rh,       hz]   -- left
    bakeBox verts faces [ rw - bar, -rh, -hz] [ rw,      rh,       hz]   -- right

    -- normalize: rectangle exactly 1.0 wide
    local s = 1.0 / (rw * 2.0)
    for i = 1 to verts.count do verts[i] = verts[i] * s

    local f = createFile outPath
    if f == undefined then format "[bake_gizmo] cannot write %\n" outPath
    else
    (
        format "/*  MaxScatter -- baked gizmo geometry\n\n" to:f
        format "    GENERATED by build/bake_gizmo.ms -- do not hand-edit.\n\n" to:f
        format "    The world sign: the text \"MaxScatter\" inside a rectangle. Baked so\n" to:f
        format "    the runtime never creates a scene node just to draw an icon: the old\n" to:f
        format "    lazy build ran on the first regen only, so a freshly created helper\n" to:f
        format "    showed a placeholder bar until some parameter changed. Baking also\n" to:f
        format "    makes the sign independent of the fonts installed on the machine.\n\n" to:f
        format "    NORMALIZED: the rectangle is exactly 1.0 wide and centred on the\n" to:f
        format "    origin, so this data carries no unit-system assumption -- scaling by\n" to:f
        format "    iconSize is all the runtime does.\n*/\n\n" to:f
        format "global MaxScatter\n\n" to:f
        format "struct MaxScatter_GizmoData\n(\n" to:f
        format "    width = 1.0,\n\n" to:f
        format "    verts = #(\n" to:f
        for i = 1 to verts.count do
        (
            local p = verts[i]
            format "        [%,%,%]%\n" \
                (formattedPrint p.x format:".5f") \
                (formattedPrint p.y format:".5f") \
                (formattedPrint p.z format:".5f") \
                (if i < verts.count then "," else "") to:f
        )
        format "    ),\n\n    faces = #(\n" to:f
        for i = 1 to faces.count do
        (
            local q = faces[i]
            format "        [%,%,%]%\n" (q.x as integer) (q.y as integer) (q.z as integer) \
                (if i < faces.count then "," else "") to:f
        )
        format "    )\n)\n\nMaxScatter.gizmoData = MaxScatter_GizmoData()\n" to:f
        close f
        format "[bake_gizmo] wrote % -- % verts, % faces\n" outPath verts.count faces.count
    )
)

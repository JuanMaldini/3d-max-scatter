<?xml version="1.0" encoding="utf-8"?>
<!--
    MaxScatter: 3ds Max application package.

    NOTE for editors: a double hyphen is illegal inside an XML comment, so the
    prose here cannot use the dash separator the MAXScript sources do. Validate
    this file after editing. Max reads a malformed manifest far enough to
    complain about something else entirely, which sends you hunting in the
    wrong place.

    One package serves 2024 through 2027. MaxScatter is pure MAXScript with no
    SDK or Qt binding, so there is nothing to compile per release; Max decides
    which versions load it from the RuntimeRequirements below.

    Why a package instead of scripts/startup: the host loads a ComponentEntry
    script as part of its own plugin startup, early enough for the scripted
    plugin class to exist before any scene opens, and it reads the menu
    declaration in Contents/cui without a script having to race the menu build.

    AppVersion and FriendlyVersion are rewritten from core/ns.ms by
    build/build_mzp.ps1, which is the single source of truth for the version, so
    do not hand-edit them here.
-->
<ApplicationPackage SchemaVersion="1.0"
    AutodeskProduct="3ds Max"
    ProductType="Application"
    Name="MaxScatter"
    Description="Open source scattering tool for 3ds Max"
    AppVersion="0.1.0"
    FriendlyVersion="0.1.0"
    Author="Juan Maldini"
    ProductCode="{1BAED929-6FBB-4D74-AAF2-336EBF731C3A}"
    UpgradeCode="{9B2369D8-8E69-4680-B972-8404697715D2}">

    <CompanyDetails Name="MaxScatter"
        Url="https://github.com/JuanMaldini/3d-max-scatter" />

    <RuntimeRequirements OS="Win64" Platform="3ds Max"
        SeriesMin="2024" SeriesMax="2027" />

    <!--
        Components/@Description is NOT free text: Max validates it against a
        fixed set naming what kind of component this is, and rejects anything
        else at startup with "invalid value for Description attribute". The
        accepted values are:
            pre-start-up scripts parts     post-start-up scripts parts
            macroscripts parts             menu parts
            plugins parts                  osl folders parts
            amg folders parts              scene converter folders parts

        post-start-up, matching CivilView: it still runs before any scene file
        is loaded, which is the actual requirement. A scripted plugin class has
        to exist before a scene that uses it opens, or its objects come back as
        Missing Plugin.
    -->
    <Components Description="post-start-up scripts parts">
        <RuntimeRequirements OS="Win64" Platform="3ds Max"
            SeriesMin="2024" SeriesMax="2027" />
        <ComponentEntry ModuleName="./Contents/scripts/MaxScatter/init.ms" />
    </Components>

    <Components Description="macroscripts parts">
        <RuntimeRequirements OS="Win64" Platform="3ds Max"
            SeriesMin="2024" SeriesMax="2027" />
        <ComponentEntry ModuleName="./Contents/macroscripts/MaxScatter.mcr" />
    </Components>

    <!--
        Declarative main menu entry. 2025 deleted menuMan and rebuilt the menu
        system around configurations the host assembles itself, so the menu is
        declared in XML rather than built by a script. 2024 has no .mnx: it is
        gated out here, and ui/menu.ms builds the menu through menuMan instead.
    -->
    <Components Description="menu parts">
        <RuntimeRequirements OS="Win64" Platform="3ds Max"
            SeriesMin="2025" SeriesMax="2027" />
        <ComponentEntry ModuleName="./Contents/cui/MaxScatter.mnx" />
    </Components>

</ApplicationPackage>
